{
  "title": "Implement, review, fix",
  "about": "Claude implements, Codex reviews, Claude fixes until the review passes",
  "inputs": { "task": { "label": "Task", "required": true } },
  "steps": [
    { "id": "implement", "agent": ["claude"], "task": "{{input.task}}" },
    { "id": "test", "run": ["bun", "test"], "allowFail": true },
    { "id": "review", "agent": ["codex"], "task": "Review the uncommitted diff. Tests said:\n{{test.output}}", "answer": { "blocking": "number", "summary": "text" } },
    { "id": "fix", "continue": "implement", "when": "{{review.blocking}} > 0", "task": "Fix what the review found:\n{{review.summary}}", "goto": "test", "max": 3 },
    { "id": "ship", "approve": "Open the PR?", "show": "{{review.summary}}" },
    { "id": "pr", "continue": "implement", "task": "Open a PR for this work." }
  ]
}
